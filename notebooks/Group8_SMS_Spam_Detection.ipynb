        "## 4. Clean labels and check duplicates\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "eb1ff076",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "eb1ff076",
        "outputId": "651143d7-7167-4245-ba0a-a2acbaa873cf"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Rows after cleaning: 5572\n",
            "Unique normalized message groups: 5157\n"
          ]
        }
      ],
      "source": [
        "df = df.dropna(subset=[\"label\", \"text\"]).copy()\n",
        "df = df.reset_index(drop=True)\n",
        "df[\"row_id\"] = np.arange(len(df))\n",
        "df[\"label\"] = df[\"label\"].astype(str).str.lower().str.strip()\n",
        "df[\"text\"] = df[\"text\"].astype(str).str.strip()\n",
        "df = df[df[\"label\"].isin([\"ham\", \"spam\"])].copy()\n",
        "df = df[df[\"text\"] != \"\"].copy()\n",
        "df[\"target\"] = df[\"label\"].map({\"ham\": 0, \"spam\": 1}).astype(int)\n",
        "\n",
        "def normalize_for_duplicate_check(message):\n",
        "    return re.sub(r\"\\s+\", \" \", str(message).strip().lower())\n",
        "\n",
        "df[\"group_key\"] = df[\"text\"].apply(normalize_for_duplicate_check)\n",
        "print(\"Rows after cleaning:\", len(df))\n",
        "print(\"Unique normalized message groups:\", df.group_key.nunique())"
      ]
    },
